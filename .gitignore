# Git ignore policy — Git pattern format
# Keep source, specifications, documentation, designs, tests, evidence, and canonical artifacts tracked.

# Dependencies
node_modules/
.pnpm-store/
.yarn/cache/
.yarn/install-state.gz

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build / packaging output
dist/
build/
out/
*.egg-info/
.eggs/

# Runtime / temporary output
*.log
*.tmp
*.temp
*.cache
.cache/
tmp/
temp/

# Environment and local secrets
.env
.env.*
!.env.example

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Test / coverage artifacts
coverage/
.nyc_output/

# Local tooling state
.direnv/
